{
  "manifest_version": 3,
  "name": "FC Sync",
  "version": "2.0.0",
  "description": "Futbin oyuncu senkronizasyonlarını FC Sync dashboard üzerinden yönetir.",
  "permissions": ["storage", "alarms", "offscreen", "tabs", "scripting"],
  "host_permissions": [
    "https://www.futbin.com/*",
    "https://futbin.com/*",
    "https://api.sbcmonster.com/*",
    "http://localhost:5055/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.futbin.com/*", "https://futbin.com/*"],
      "js": ["src/modules/latest/content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.futbin.com/*", "https://futbin.com/*"],
      "js": ["src/modules/important/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        ".env",
        "src/config/api.js",
        "src/assets/img/appLogoSmall.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],	
  "action": {
    "default_title": "FC Sync Dashboard"
  }
}
